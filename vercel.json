{
  "functions": {
    "api/*.js": {
      "includeFiles": "{js/data.js,tools/estoque.json,tools/custos.json}"
    }
  },
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
